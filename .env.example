# Copy to .env.local for development. In production these are set in the
# Vercel project settings (Settings -> Environment Variables), not here.
#
# Every NEXT_PUBLIC_ value is inlined into the browser bundle at BUILD time,
# so changing one in Vercel requires a redeploy before it reaches visitors.

# Absolute URL for canonical tags, Open Graph, sitemap and robots.
# Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://web.konarksoft.com

# The line every WhatsApp CTA opens. Country code first, digits only.
# Defaults to the placeholder 919000000000 when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Measurement -----------------------------------------------------------
# All optional: with every one blank the site loads no third-party script.

# GA4 property, e.g. G-XXXXXXXXXX. Reports each lead as `generate_lead`.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads account. This alone is what puts the Google tag on the site and
# clears the "Your website is missing a Google tag" diagnostic.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18462404448

# The conversion action's label, from Google Ads -> Goals -> Conversions ->
# (your action) -> Tag setup -> Install the tag yourself. Looks like
# AbC-D_efGh12. Ads needs this AND the id above: either alone records nothing,
# so leads will not be counted until this is filled in.
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Meta pixel from Events Manager. Fires the standard `Lead` event.
NEXT_PUBLIC_META_PIXEL_ID=
